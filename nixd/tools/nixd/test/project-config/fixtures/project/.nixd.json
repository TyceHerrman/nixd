{
  "formatting": {
    "command": ["sh", "-c", "printf project-format"]
  },
  "nixpkgs": {
    "expr": "{ project.meta.description = \"project nixpkgs\"; }"
  },
  "options": {
    "project": {
      "expr": "{ project.option = { _type = \"option\"; }; }"
    }
  },
  "diagnostic": {
    "suppress": ["sema-unused-def-lambda-noarg-formal"]
  }
}
