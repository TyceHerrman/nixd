{
  "$comment": "Strict configuration-patch grammar accepted by nixd.",
  "$id": "https://json.schemastore.org/nixd-schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "nixd configuration patch",
  "description": "A strict patch for --config, an opted-in .nixd.json, or the nixd LSP editor section.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "description": "Optional string metadata. nixd does not fetch or interpret the referenced schema.",
      "type": "string"
    },
    "nixpkgs": {
      "$ref": "#/definitions/nixpkgs"
    },
    "formatting": {
      "$ref": "#/definitions/formatting"
    },
    "options": {
      "$ref": "#/definitions/options"
    },
    "diagnostic": {
      "$ref": "#/definitions/diagnostic"
    }
  },
  "definitions": {
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nixpkgs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expr": {
          "description": "Expression interpreted as the nixpkgs top level. An empty string disables evaluation.",
          "type": "string"
        }
      }
    },
    "formatting": {
      "description": "A nonempty command string or an object with an optional command array.",
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "command": {
              "$ref": "#/definitions/stringArray"
            }
          }
        }
      ]
    },
    "optionProvider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expr"
      ],
      "properties": {
        "expr": {
          "description": "Expression evaluating to an option declaration attrset.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "options": {
      "description": "A complete map of option providers. An empty object disables option providers.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/optionProvider"
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "suppress": {
          "$ref": "#/definitions/stringArray"
        }
      }
    }
  }
}
