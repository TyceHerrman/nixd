{
  "$comment": "https://github.com/nix-community/nixd/blob/main/nixd/docs/configuration.md#configuration",
  "$id": "https://json.schemastore.org/nixd-schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "JSON schema for nixd",
  "type": "object",
  "definitions": {
    "formatting": {
      "description": "The formatter command and arguments. A string is shorthand for a one-element command array.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "command": {
              "description": "The formatter executable followed by its arguments.",
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": [
                "nixfmt"
              ]
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "optionProvider": {
      "description": "A named source of option declarations.",
      "type": "object",
      "properties": {
        "expr": {
          "description": "A Nix expression that evaluates to an options attribute set.",
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "nixpkgsProvider": {
      "description": "The nixpkgs source used for package and library features.",
      "type": "object",
      "properties": {
        "expr": {
          "description": "A Nix expression interpreted as the nixpkgs top level.",
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "diagnostic": {
      "description": "Diagnostic configuration.",
      "type": "object",
      "properties": {
        "suppress": {
          "description": "Diagnostic short names to suppress.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "properties": {
    "formatting": {
      "$ref": "#/definitions/formatting"
    },
    "options": {
      "description": "Named option providers. Supplying this map replaces the active base map.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/optionProvider"
      }
    },
    "nixpkgs": {
      "$ref": "#/definitions/nixpkgsProvider"
    },
    "diagnostic": {
      "$ref": "#/definitions/diagnostic"
    }
  },
  "additionalProperties": true
}
